# MCP Server – Best Alpine Wellness Hotels

PORT=3001

# Interne .NET-API (Produktion typisch: http://127.0.0.1:8080)
API_BASE_URL=http://localhost:5001

# Timeout für API-Aufrufe (ms)
API_TIMEOUT_MS=90000

# Rate Limit: Requests pro Minute pro IP
RATE_LIMIT_PER_MINUTE=60

# Domain-Verifikation OpenAI – reiner Text-Token aus dem Einreichungsportal
# OPENAI_APPS_CHALLENGE_TOKEN=PASTE_TOKEN_HERE

# Optional: zusätzliche erlaubte CORS-Origins (kommagetrennt).
# Leer = Default (chatgpt.com, openai.com, localhost)
# CORS_ORIGINS=https://chatgpt.com,http://localhost:6274

# Debug-Endpunkt /debug-last-call nur lokal
ENABLE_DEBUG=false
