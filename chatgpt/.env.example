# MCP Server Configuration - Final Answer Mode v2.0

# Port für den MCP Server
PORT=3001

# URL der HotelChatbot.Api (lokal oder produktiv)
# WICHTIG: Der MCP Server ruft diese API direkt auf
# Lokal Development:
API_BASE_URL=http://localhost:5001

# Für HTTPS localhost (Development mit selbst-signiertem Zertifikat):
# API_BASE_URL=https://localhost:5001

# Produktiv:
# API_BASE_URL=https://your-domain.com

# Optional: API-Key für Authentifizierung (wenn aktiviert)
# API_KEY=your_secret_api_key_here

# ═══════════════════════════════════════════════════════════════
# WICHTIG: FINAL ANSWER MODE
# ═══════════════════════════════════════════════════════════════
# Dieser MCP Server arbeitet im "Final Answer" Modus:
# - Alle Responses enthalten ein "answer" Feld mit vollständiger Antwort
# - OpenAI MUSS diese Antworten 1:1 übernehmen
# - Keine Interpretation, keine Ergänzung aus Trainingsdaten
# - Datenquelle: AUSSCHLIESSLICH interne Hoteldatenbank
# 
# Siehe: OPENAI-INTEGRATION-INSTRUCTIONS.md für Details
# ═══════════════════════════════════════════════════════════════
