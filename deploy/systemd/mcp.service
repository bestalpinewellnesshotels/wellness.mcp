[Unit]
Description=BestWellness MCP Server (Streamable HTTP /mcp)
After=network.target hotelchatbot-api.service
Wants=hotelchatbot-api.service

[Service]
Type=simple
WorkingDirectory={{REMOTE_MCP_DIR}}
ExecStart={{NODE_BIN}} {{REMOTE_MCP_DIR}}/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT={{MCP_PORT}}
Environment=API_BASE_URL=http://127.0.0.1:{{API_PORT}}
Environment=API_TIMEOUT_MS=90000
Environment=ENABLE_DEBUG=false
# Optional: Token für GET /.well-known/openai-apps-challenge
# Environment=OPENAI_APPS_CHALLENGE_TOKEN=
EnvironmentFile=-{{REMOTE_MCP_DIR}}/.env

[Install]
WantedBy=default.target
